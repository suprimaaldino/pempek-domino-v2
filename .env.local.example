# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Admin Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=admin@example.com

# Generate with:
# node -e "const b=require('bcryptjs');console.log(b.hashSync('your_password',12))"
# NOTE: escape every $ as \$ — Next.js env loader expands bare $ as variables
ADMIN_PASSWORD_HASH=\$2b\$12\$your_bcrypt_hash

# Only required by local seed scripts if applicable.
# Do NOT use in production.
# Quote if password contains # or other special chars (dotenv strips unquoted #…)
ADMIN_PASSWORD="your_local_admin_password"

# Optional client-side admin UX guard
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Firebase Admin SDK
# Put the complete service-account JSON as a single-line JSON string.
# NEVER commit the real service-account key.
FIREBASE_SERVICE_ACCOUNT_KEY=your_firebase_service_account_json