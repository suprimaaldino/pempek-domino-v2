# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin Credentials (server-only — NEVER use NEXT_PUBLIC_ prefix)
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin@email.com
# bcrypt hash of the admin password
# Generate with: node -e "const b=require('bcryptjs');console.log(b.hashSync('your_password',12))"
ADMIN_PASSWORD_HASH=
# Plain password — ONLY needed locally by scripts/seed.ts. Do not set in production.
ADMIN_PASSWORD=

# Firebase Admin SDK (server-only — JSON string from service account key)
# Generate at: https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
FIREBASE_SERVICE_ACCOUNT_KEY=
