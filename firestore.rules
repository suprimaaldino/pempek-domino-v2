rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin only: custom claim `admin: true` set by /api/admin/login via Admin SDK.
    // Do NOT use plain isAuthenticated() for privileged writes — any Google
    // customer session is authenticated but must not mutate admin data.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidString(value, minLength, maxLength) {
      return value is string &&
             value.size() >= minLength &&
             value.size() <= maxLength;
    }

    function isValidPhone(number) {
      return number is string &&
             number.matches('^628[0-9]{8,12}$');
    }

    // NOTE: rules.List has no .all(predicate). Per-item field validation is
    // enforced server-side in POST /api/order (Admin SDK bypasses rules).
    // Here we only constrain list shape/size (guest client create path).
    function isValidOrder(data) {
      return data.keys().hasAll([
        'customerName', 'whatsappNumber', 'items',
        'subtotal', 'total', 'deliveryMethod'
      ]) &&
        isValidString(data.customerName, 2, 100) &&
        isValidPhone(data.whatsappNumber) &&
        data.items is list &&
        data.items.size() > 0 &&
        data.items.size() <= 100 &&
        data.subtotal is number &&
        data.subtotal >= 0 &&
        data.total is number &&
        data.total > 0 &&
        data.total < 100000000 && // Max 100M
        data.deliveryMethod in ['pickup', 'delivery'] &&
        (!data.keys().hasAny(['deliveryFee']) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 1000000));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'isActive']) &&
             isValidString(data.name, 1, 200) &&
             data.price is number &&
             data.price >= 0 &&
             data.price <= 10000000 && // Max 10M
             data.category is string;
    }

    // ─── Products ─────────────────────────────────────────────────────────

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['createdAt']); // Prevent createdAt modification
      allow delete: if isAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────────────────
    // Create: still validated shape (guest checkout / server Admin SDK bypasses rules).
    // Read: admin, or the authenticated owner of the order.
    // Mutations: admin only.

    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['createdAt', 'orderNumber', 'items']); // items frozen after creation
      allow delete: if isAdmin();
    }

    // ─── Order Lookups ────────────────────────────────────────────────────
    // get: public so guest flows that resolve orderNumber → orderId still work
    // when not using Admin SDK. Writes are admin-only.

    match /orderLookups/{orderNumber} {
      allow create: if
        request.resource.data.keys().hasAll(['orderId', 'createdAt']) &&
        isValidString(request.resource.data.orderId, 1, 200);
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // ─── Counters ─────────────────────────────────────────────────────────

    match /counters/{counterId} {
      // Daily order-number counter, incremented by guest checkout.
      // Hardened instead of auth-only (which would break guests):
      // - field shape locked to { count }
      // - create must start at exactly 1
      // - update must increment by exactly 1, capped per day
      allow get: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == 1;
      allow update: if
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count is number &&
        request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.count < 100000;
    }

    // ─── Customers ────────────────────────────────────────────────────────

    match /customers/{customerId} {
      // Anyone can create a record for their own phone number
      allow create: if
        request.resource.data.keys().hasAll(['name', 'whatsappNumber']) &&
        request.resource.data.whatsappNumber == customerId;
      // Admin any; otherwise only the owner of that phone record (guest upsert)
      allow update: if isAdmin() ||
        resource.data.whatsappNumber == customerId;
      allow read, delete: if isAdmin();
    }

    // ─── Users (authenticated customer accounts) ────────────────────────────
    // users/{uid} — canonical authenticated identity. Only the owner (matching
    // Firebase uid) may read or update their own record. Guest order creation
    // does NOT touch this collection, so the guest flow is unaffected.

    function isOwnerOfUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwnerOfUser(uid) || isAdmin();
      allow create, update: if
        isOwnerOfUser(uid) &&
        request.resource.data.keys().hasAll(['email', 'name', 'phone', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    // ─── Payment Config ───────────────────────────────────────────────────

    match /paymentConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Settings ─────────────────────────────────────────────────────────

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
