# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env.local
.env.development
.env.production
.env.test
.env*.local
# catch-all for any other env variant, but keep the committed templates tracked
.env*
!.env.example
!.env.local.example

# vercel
.vercel
.next-dev.err.log
.next-dev.log
VERCEL_ENV_SETUP.md

# local dev logs (transcripts of `next dev` runs)
dev.log
dev.err
*.log

# opencode tooling (local AI coding agent config)
opencode.jsonc
.opencode/
.opencodeopencode.jsonc

# local tooling / scratch
*.local
scratch/

# typescript
*.tsbuildinfo
next-env.d.ts

# generated PWA artifacts (regenerated by @ducanh2912/next-pwa on every build)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map

# playwright
/playwright-report/
/test-results/
/blob-report/
/.playwright/
